{
  "name": "pixie-companion",
  "productName": "Pixie",
  "version": "1.0.0",
  "description": "Pixie - a sweet, spicy, cute anime desktop companion that sees your gestures, hears your voice and runs agentic tasks.",
  "main": "main.js",
  "author": "Pixie",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/fetch-vision.js",
    "start": "electron .",
    "dist": "electron-builder --win zip --x64 --publish never"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "electronDownload": {
      "cache": "/tmp/electron-cache"
    },
    "appId": "com.pixie.companion",
    "productName": "Pixie",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "zip"
        }
      ],
      "executableName": "Pixie",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pixie",
      "artifactName": "Pixie-Setup-${version}.${ext}"
    },
    "extraMetadata": {
      "version": "1.0.0"
    }
  }
}